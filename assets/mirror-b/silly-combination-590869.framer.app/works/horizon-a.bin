"800" sizes="(min-width: 1200px) 100vw, (min-width: 810px) and (max-width: 1199.98px) 100vw, (max-width: 809.98px) 100vw" srcset="http://localhost:8766/_assets/framerusercontent.com/images/VJR2tpvQTbtvxZmeAxF5UHQPx1U_24a81cc30e.webp 512w,http://localhost:8766/_assets/framerusercontent.com/images/VJR2tpvQTbtvxZmeAxF5UHQPx1U_9dea1a29b8.webp 1024w,http://localhost:8766/_assets/framerusercontent.com/images/VJR2tpvQTbtvxZmeAxF5UHQPx1U_45cd08373c.webp 1200w" src="http://localhost:8766/_assets/framerusercontent.com/images/VJR2tpvQTbtvxZmeAxF5UHQPx1U_45cd08373c.webp" alt="Horizon Atlas is a travel platform that curates personalized itineraries for modern explorers" style="display:block;width:100%;height:100%;border-radius:inherit;corner-shape:inherit;object-position:center;object-fit:cover"></div></div></div><div class="ssr-variant hidden-qo13er hidden-2jwbv0"><div class="framer-16sfcq1" data-framer-appear-id="16sfcq1" data-framer-name="Details" style="opacity:0.001;transform:translateY(100px)"><div class="framer-wy1v9u" data-framer-name="Container"><div class="framer-eo1xm8" data-framer-name="Content"><div class="framer-i1kgq8" data-framer-component-type="RichTextContainer" style="transform:none"><h1 class="framer-text framer-styles-preset-jyira9" data-styles-preset="xOozWzlxf">Horizon Atlas</h1></div><div class="framer-ftn7ch" data-framer-name="Info"><div class="framer-fwcz8y" data-framer-name="Overview"><div class="framer-1f36vk" data-framer-component-type="RichTextContainer" style="transform:none"><p class="framer-text framer-styles-preset-wz1c9z" data-styles-preset="lZAQuSrwp" style="--framer-text-color:var(--token-923661f6-bb67-400f-9b15-4dbe77975e9c, rgb(113, 118, 127))">Overview</p></div><div class="framer-1j5yk2d" data-framer-name="Content" data-framer-component-type="RichTextContainer" style="transform:none"><p class="framer-text framer-styles-preset-wz1c9z">Horizon Atlas is a travel platform that curates personalized itineraries for modern explorers. The goal was to create a visually immersive and highly functional website that enhances the planning experience. With an emphasis on stunning imagery and intuitive navigation, the website needed to inspire and simplify trip booking.</p><p class="framer-text framer-styles-preset-wz1c9z">To achieve this, the design incorporates a seamless search experience, interactive destination guides, and a booking system that feels effortless. A balance of rich media and clean UI ensures users stay engaged while easily accessing essential travel details. The end result is a platform that transforms trip planning into an exciting, stress-free process.</p></div></div><div class="framer-sttefw" data-framer-name="Categories"><div class="framer-14a0e4w" data-framer-component-type="RichTextContainer" style="transform:none"><p class="framer-text framer-styles-preset-wz1c9z" data-styles-preset="lZAQuSrwp" style="--framer-text-color:var(--token-923661f6-bb67-400f-9b15-4dbe77975e9c, rgb(113, 118, 127))">Categories</p></div><div class="framer-1c7l7ez" data-framer-name="Tags"><div class="framer-b8yvdc" data-framer-component-type="RichTextContainer" style="transform:none"><p class="framer-text framer-styles-preset-wz1c9z" data-styles-preset="lZAQuSrwp">Travel</p></div><div class="framer-yyic9l" data-framer-name="Dot"></div><div class="framer-8639ux" data-framer-component-type="RichTextContainer" style="transform:none"><p class="framer-text framer-styles-preset-wz1c9z" data-styles-preset="lZAQuSrwp">Web Design</p></div></div></div><div class="framer-1tnpj02" data-framer-name="Date"><div class="framer-17zpqx9" data-framer-component-type="RichTextContainer" style="transform:none"><p class="framer-text framer-styles-preset-wz1c9z" data-styles-preset="lZAQuSrwp" style="--framer-text-color:var(--token-923661f6-bb67-400f-9b15-4dbe77975e9c, rgb(113, 118, 127))">Date</p></div><div class="framer-1xbf1md" data-framer-component-type="RichTextContainer" style="transform:none"><p class="framer-text framer-styles-prese